{
    "$schema": "http://json-schema.org/draft-07/schema",
    "$id": "https://raw.githubusercontent.com/aledavini7/download_dbgap/main/nextflow_schema.json",
    "title": "download_dbgap pipeline parameters",
    "description": "Download dbGaP SRA files and convert them to BAM.",
    "type": "object",

    "definitions": {

        "input_output_options": {
            "title": "Input/output options",
            "type": "object",
            "fa_icon": "fas fa-terminal",
            "description": "Define input files and output directory.",

            "required": [
                "accession_list",
                "outdir"
            ],

            "properties": {

                "accession_list": {
                    "type": "string",
                    "format": "file-path",
                    "description": "Text file containing one SRA accession per line.",
                    "fa_icon": "fas fa-file-alt"
                },

                "outdir": {
                    "type": "string",
                    "format": "directory-path",
                    "description": "Directory where BAM files will be saved.",
                    "fa_icon": "fas fa-folder-open"
                }
            }
        },

        "dbgap_options": {
            "title": "dbGaP options",
            "type": "object",
            "fa_icon": "fas fa-key",
            "description": "dbGaP authentication settings.",

            "required": [
                "my_key"
            ],

            "properties": {

                "my_key": {
                    "type": "string",
                    "format": "file-path",
                    "description": "Path to the dbGaP .ngc key file.",
                    "default": "/hpcscratch/ieo/ieo5898/dbgap_key/prj_32315.ngc"
                }
            }
        }
    },

    "allOf": [
        {
            "$ref": "#/definitions/input_output_options"
        },
        {
            "$ref": "#/definitions/dbgap_options"
        }
    ]
}