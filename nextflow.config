// Config file

singularity.enabled = true
singularity.autoMounts = true
singularity.runOptions = ' --bind /hpcnfs/ --bind /hpcscratch/ --bind /beegfs/'

params {
    my_key = '/hpcscratch/ieo/ieo5898/dbgap_key/prj_32315.ngc'
    sratoolkit = '/hpcscratch/ieo/seqera-ederenzini/download_dbgap/sratoolkit.3.0.6-ubuntu64/bin/sam-dump'
}

process {
    executor = 'slurm'
    queue = 'seqera'
    scratch = '/hpcscratch/ieo/seqera-ederenzini/'

    errorStrategy = 'retry'
    maxRetries = 1

    withLabel: download {
        container = 'docker://quay.io/biocontainers/sra-tools:3.2.1--h4304569_1'
        cpus = 1
        memory = 8.GB
        time = 24.h
        scratch = false
    	maxRetries = 0
    }

    withLabel: sam_dump {
        container = 'docker://quay.io/biocontainers/sra-tools:3.2.1--h4304569_1'
        cpus = 2
        memory = 8.GB
        time = 24.h
    }

    withLabel: sam_to_bam {
        container = 'docker://quay.io/biocontainers/samtools:1.20--h50ea8bc_1'
        cpus = 2
        memory = 8.GB
        time = 24.h
    }

}

tower {
    workspaceId = '52536440408009'
    endpoint = 'https://seqera.ieo.it/api'
    enabled = true
}
